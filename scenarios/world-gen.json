{
  "name": "world-gen",
  "seed": 42,
  "options": { "difficulty": "steady", "mapSize": 0 },
  "steps": [
    { "assert": { "query": "maps", "path": "maps.length", "op": "eq", "value": 1 } },
    {
      "assert": {
        "query": "map",
        "args": { "mapId": 1 },
        "path": "cellCount",
        "op": "eq",
        "value": 600
      }
    },
    {
      "assert": {
        "query": "map",
        "args": { "mapId": 1 },
        "path": "params.generator",
        "op": "eq",
        "value": "outdoor"
      }
    },
    {
      "assert": {
        "query": "map",
        "args": { "mapId": 1 },
        "path": "terrain",
        "op": "includes",
        "value": "water_shallow"
      }
    },
    {
      "assert": {
        "query": "map",
        "args": { "mapId": 1 },
        "path": "terrain",
        "op": "includes",
        "value": "fertile_soil"
      }
    },
    {
      "assert": {
        "query": "map",
        "args": { "mapId": 1 },
        "path": "terrain",
        "op": "includes",
        "value": "forest_oak"
      }
    },
    {
      "assert": {
        "query": "map",
        "args": { "mapId": 1 },
        "path": "terrain",
        "op": "includes",
        "value": "stone_deposit"
      }
    },
    {
      "assert": {
        "query": "map",
        "args": { "mapId": 1 },
        "path": "terrain",
        "op": "includes",
        "value": "iron_ore_deposit"
      }
    },
    {
      "assert": {
        "query": "map",
        "args": { "mapId": 1 },
        "path": "terrain",
        "op": "includes",
        "value": "road_dirt"
      }
    },
    {
      "assert": {
        "query": "entities",
        "args": { "prototype": "job_board" },
        "path": "total",
        "op": "eq",
        "value": 1
      }
    },
    {
      "assert": {
        "query": "entities",
        "args": { "prototype": "farmer" },
        "path": "total",
        "op": "eq",
        "value": 2
      }
    },
    {
      "assert": {
        "query": "entities",
        "args": { "prototype": "chest" },
        "path": "total",
        "op": "eq",
        "value": 1
      }
    },
    { "assert": { "query": "entities", "path": "total", "op": "eq", "value": 18 } },
    { "assert": { "query": "settlement", "path": "population", "op": "eq", "value": 6 } },
    { "assertHash": { "label": "generated" } },
    { "step": 100 },
    { "saveLoad": true },
    { "assert": { "query": "entities", "path": "total", "op": "eq", "value": 20 } },
    {
      "assert": {
        "query": "map",
        "args": { "mapId": 1 },
        "path": "terrain",
        "op": "includes",
        "value": "iron_ore_deposit"
      }
    },
    { "replay": true }
  ]
