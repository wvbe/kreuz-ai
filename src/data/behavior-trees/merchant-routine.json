{
  "id": "merchant_routine",
  "name": "Merchant Behavior",
  "root": {
    "type": "selector",
    "name": "merchant_root",
    "children": [
      {
        "type": "sequence",
        "name": "open_shop",
        "children": [
          {
            "type": "condition",
            "name": "market_available",
            "check": "market_zone_available_and_daytime"
          },
          {
            "type": "action",
            "name": "travel_market",
            "action": "travel_to_market"
          },
          {
            "type": "action",
            "name": "await_trades",
            "action": "await_trade_offers"
          }
        ]
      },
      {
        "type": "sequence",
        "name": "restock",
        "children": [
          {
            "type": "condition",
            "name": "low_inventory",
            "check": "inventory_below_restock_threshold"
          },
          {
            "type": "action",
            "name": "query_goods",
            "action": "query_available_goods"
          },
          {
            "type": "action",
            "name": "travel_source",
            "action": "travel_to_source"
          },
          {
            "type": "action",
            "name": "purchase",
            "action": "purchase_restock"
          }
        ]
      },
      {
        "type": "action",
        "name": "fallback_routine",
        "action": "daily_routine_fallback"
      }
    ]
  }
}
