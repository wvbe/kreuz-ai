{
  "id": "predator_behavior",
  "name": "Wild Predator Behavior",
  "root": {
    "type": "selector",
    "name": "predator_root",
    "children": [
      {
        "type": "sequence",
        "name": "hunt",
        "children": [
          {
            "type": "condition",
            "name": "prey_detected",
            "check": "prey_within_range"
          },
          {
            "type": "action",
            "name": "stalk",
            "action": "stalk_prey"
          },
          {
            "type": "action",
            "name": "attack",
            "action": "attack_prey"
          }
        ]
      },
      {
        "type": "sequence",
        "name": "territorial",
        "children": [
          {
            "type": "condition",
            "name": "intruder_detected",
            "check": "humanoid_in_territory"
          },
          {
            "type": "selector",
            "name": "territorial_response",
            "children": [
              {
                "type": "action",
                "name": "attack_intruder",
                "action": "attack_intruder"
              },
              {
                "type": "action",
                "name": "flee",
                "action": "flee_from_intruder"
              }
            ]
          }
        ]
      },
      { "type": "action", "name": "wander", "action": "wander_territory" }
    ]
  }
}
