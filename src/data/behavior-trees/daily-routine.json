{
  "id": "daily_routine",
  "name": "Universal Daily Cycle",
  "root": {
    "type": "selector",
    "name": "daily_routine_root",
    "children": [
      {
        "type": "sequence",
        "name": "critical_needs",
        "children": [
          {
            "type": "condition",
            "name": "any_need_critical",
            "check": "any_need_below_critical_threshold"
          },
          {
            "type": "action",
            "name": "satisfy_critical",
            "action": "satisfy_critical_need",
            "scoring": "utility"
          }
        ]
      },
      {
        "type": "sequence",
        "name": "work_cycle",
        "children": [
          {
            "type": "condition",
            "name": "job_available",
            "check": "job_available_on_claimed_board"
          },
          {
            "type": "action",
            "name": "travel_to_work",
            "action": "travel_to_worksite"
          },
          {
            "type": "action",
            "name": "gather",
            "action": "gather_materials"
          },
          {
            "type": "action",
            "name": "work",
            "action": "perform_work"
          }
        ]
      },
      {
        "type": "sequence",
        "name": "social_comfort",
        "children": [
          {
            "type": "condition",
            "name": "social_or_comfort_low",
            "check": "social_or_comfort_below_40"
          },
          {
            "type": "selector",
            "name": "seek_social_or_comfort",
            "children": [
              {
                "type": "action",
                "name": "seek_conversation",
                "action": "seek_conversation"
              },
              {
                "type": "action",
                "name": "seek_comfort",
                "action": "seek_comfort"
              }
            ]
          }
        ]
      },
      {
        "type": "sequence",
        "name": "faith_worship",
        "children": [
          {
            "type": "condition",
            "name": "faith_low",
            "check": "faith_below_30_and_religious"
          },
          {
            "type": "action",
            "name": "attend_worship",
            "action": "attend_worship"
          }
        ]
      },
      { "type": "action", "name": "idle", "action": "idle_wander" }
    ]
  }
}
